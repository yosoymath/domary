DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require"
NEXTAUTH_URL="http://localhost:3000"
AUTH_SECRET="generate-a-random-secret-with-at-least-32-bytes"
# URL pública do site (em produção, obrigatoriamente HTTPS; usada pelo webhook do PagBank)
APP_URL="http://localhost:3000"

# E-mail transacional (https://resend.com)
RESEND_API_KEY="re_your_api_key"
EMAIL_FROM="Domary <noreply@your-domain.com>"
CONTACT_EMAIL="contact@your-domain.com"

# Armazenamento persistente de imagens (https://cloudinary.com)
CLOUDINARY_URL="cloudinary://API_KEY:API_SECRET@CLOUD_NAME"

# Pagamentos PagBank (ver docs/pagbank.md)
PAGBANK_ENV="sandbox"
PAGBANK_TOKEN="your_pagbank_token"
# Parcelamento: limite de parcelas e quantas são sem juros
PAGBANK_INSTALLMENTS_LIMIT=3
PAGBANK_INTEREST_FREE_INSTALLMENTS=0

# Aviso de pedido pago por WhatsApp (ver docs/whatsapp.md)
# Número que recebe os avisos: DDI + DDD + número, só dígitos
WHATSAPP_NOTIFY_PHONE=""
# Preencha apenas UM provedor. Ordem de uso: CallMeBot, Green-API, Z-API.
CALLMEBOT_API_KEY=""
GREENAPI_ID_INSTANCE=""
GREENAPI_API_TOKEN=""
# Opcional: URL da instância informada no painel do Green-API
GREENAPI_API_URL=""
ZAPI_INSTANCE_ID=""
ZAPI_INSTANCE_TOKEN=""
# Opcional: só se a segurança por Client-Token estiver ativa na conta Z-API
ZAPI_CLIENT_TOKEN=""
